---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const data = [
  { company: "Wiz", note: "acquired by Google", period: "Nov. 2025 – Present", title: "Support Systems Engineer", url: "https://www.wiz.io",
    description: "Building the tools and systems that let support engineers move faster. Infrastructure as code with Terraform, CI/CD on CircleCI, Python services, custom CLIs and GCP Workstations." },
  { company: "MesaWorks", period: "May 2025 – Present", title: "Founder / CTO", url: "https://mesaworks.dev",
    description: "Founded a software company that builds full-stack web applications for small businesses, using Python, Node.js and React." },
  { company: "Meow Wolf", period: "Mar. 2024 – Jun. 2025", title: "Senior Software Engineer", url: "https://meowwolf.com",
    description: "Built applications that power interactive, physical experiences. Technical lead for the messaging backend and the CMS migration, with CI/CD pipelines and TypeScript extensions." },
  { company: "Google Cloud", period: "2022 – Mar. 2024", title: "Customer Engineer", url: "https://cloud.google.com",
    description: "Secured the technical wins that helped close business valued at over $15M. Built Java microservices on Kubernetes, network architecture and SQL dashboards for customer proofs of concept." },
  { company: "Google Cloud", period: "Feb. 2020 – 2022", title: "Technical Solutions Engineer", url: "https://cloud.google.com",
    description: "Resolved technical issues for S&P 500 customers on Google Cloud, with a focus on SQL query troubleshooting, and built internal tools that streamlined the support workflow." },
  { company: "SXSW", period: "Jun. 2016 – Jan. 2020", title: "Full-Stack Engineer", url: "https://www.sxsw.com",
    description: "Designed and built secure APIs serving 200k+ mobile users, and automated the AWS infrastructure behind them with Ansible." },
  { company: "Crispy Interactive", period: "Jun. 2014 – Jan. 2016", title: "Full-Stack Developer",
    description: "Full-stack developer at an interactive design studio, building Laravel PHP and AngularJS applications, including a mobile app and an e-commerce platform." },
  { company: "University of Texas at Austin", period: "Sep. 2012 – May 2014", title: "Front End Developer", url: "https://www.utexas.edu",
    description: "Rebuilt department websites for the College of Natural Sciences, used by tens of thousands of people. Developed PHP Joomla templates and a JavaScript UI framework." },
];
---

<section id="work">
  <Wrapper variant="standard">
    <div class="grid grid-cols-1 gap-6 border-b border-base-200 py-16 dark:border-base-800 md:grid-cols-[10rem_1fr]">
      <h2 class="self-start text-sm font-medium tracking-tight text-base-500 md:sticky md:top-8 md:pt-[2.15rem]">Work</h2>
      <ol class="flex flex-col">
        {data.map((job) => {
          const Tag = job.url ? "a" : "div";
          return (
            <li class="border-t border-base-200 first:border-t-0 dark:border-base-800">
              <Tag
                {...(job.url ? { href: job.url, target: "_blank", rel: "noopener" } : {})}
                class="group grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[1fr_auto]"
              >
                <div>
                  <p class="flex items-baseline gap-3 text-2xl font-medium tracking-tight text-base-950 transition-colors group-hover:text-bloom dark:text-white sm:text-3xl">
                    <span>{job.company}</span>
                    {job.url && <span class="inline-block text-lg text-base-400 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-bloom" aria-hidden="true">↗</span>}
                  </p>
                  <p class="mt-1 text-sm font-medium text-base-800 dark:text-base-200">
                    {job.title}{job.note && <span class="font-normal text-base-500"> · {job.note}</span>}
                  </p>
                  <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-600 dark:text-base-400">{job.description}</p>
                </div>
                <p class="text-sm tabular-nums text-base-500 sm:pt-2 sm:text-right">{job.period}</p>
              </Tag>
            </li>
          );
        })}
      </ol>
    </div>
  </Wrapper>
</section>
