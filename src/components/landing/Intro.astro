---
// Assets
import { Image } from "astro:assets";
import Avatar from "@/images/avatar.jpg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b pb-8 pt-24 border-base-200 dark:border-base-800"
    >

      <Image
        src={Avatar}
        alt="Craig Kahle"
        width={400}
        height={400}
        loading="eager"
        decoding="async"
        class="rounded-2xl size-24 object-cover ovjet-center"
      />
      <div class="lg:col-span-2">
        <Text
          tag="h1"
          variant="textSM"
          class="font-medium text-base-900 dark:text-white"
          >Craig Kahle</Text
        >
        <Text
          tag="p"
          variant="textXS"
          class="text-base-600 dark:text-base-600 dark:text-base-400"
          >Support Systems Engineer at Wiz (now part of Google)</Text
        >
        <Text
          tag="p"
          variant="textSM"
          class="text-base-600 dark:text-base-600 dark:text-base-400 mt-4"
        >
          I'm a software engineer with a passion for music, events and outdoors. I'm currently building tools and systems that help support engineers at Wiz. I also run <a href="https://mesaworks.dev" target="_blank">MesaWorks</a> on the side.
        </Text>
      </div>
    </div>
  </Wrapper>
</section>
