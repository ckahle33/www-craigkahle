---
import { Image } from "astro:assets";
import Avatar from "@/images/avatar.jpg";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Bloom from "@/components/assets/Bloom.astro";
---

<section class="relative overflow-hidden border-b border-base-200 dark:border-base-800">
  <div class="pointer-events-none absolute -right-[30%] top-[6%] w-[110vw] max-w-[820px] text-bloom sm:-right-[8%] sm:top-1/2 sm:-translate-y-1/2" aria-hidden="true">
    <Bloom class="bloom-spin h-auto w-full" />
  </div>
  <Wrapper variant="standard">
    <div class="relative flex min-h-[60svh] flex-col justify-end gap-10 pb-12 pt-28 sm:pb-16">
      <Image
        src={Avatar}
        alt="Craig Kahle"
        width={400}
        height={400}
        loading="eager"
        decoding="async"
        class="size-16 rounded-full object-cover ring-2 ring-white dark:ring-base-900"
      />
      <div>
        <h1 class="text-[clamp(2.75rem,8vw,6.5rem)] font-bold leading-[0.84] tracking-[-0.055em] text-base-950 dark:text-white">
          Craig<br />Kahle
        </h1>
        <p class="mt-8 max-w-md text-lg font-medium leading-snug tracking-tight text-base-900 dark:text-white sm:text-xl">
          Support Systems Engineer at Wiz, now part of Google.
        </p>
        <p class="mt-3 max-w-md text-base leading-relaxed text-base-600 dark:text-base-400">
          A software engineer with a passion for music, events and the outdoors. I also run
          <a class="underline decoration-bloom decoration-2 underline-offset-4 hover:text-bloom" href="https://mesaworks.dev" target="_blank" rel="noopener">MesaWorks</a>
          on the side.
        </p>
      </div>
    </div>
  </Wrapper>
</section>
