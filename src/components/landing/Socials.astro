---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const links = [
  {
    platform: "GitHub",
    url: "https://github.com/ckahle33",
  },
  {
    platform: "Linkedin",
    url: "https://www.linkedin.com/in/craig-kahle-53b7652b/",
  },
  {
    platform: "Email",
    url: "mailto:craig@mesaworks.dev",
  },
];
---

<section>
  <Wrapper variant="standard">
    <div class="grid grid-cols-1 gap-6 border-b border-base-200 py-16 dark:border-base-800 md:grid-cols-[10rem_1fr]">
      <h2 class="self-start text-sm font-medium tracking-tight text-base-500 md:sticky md:top-8 md:pt-3">Elsewhere</h2>
      <ul class="flex flex-wrap gap-x-10 gap-y-3">
        {links.map((social) => (
          <li>
            <a href={social.url} class="group inline-flex items-baseline gap-2 text-3xl font-medium tracking-tight text-base-950 transition-colors hover:text-bloom dark:text-white sm:text-4xl">
              {social.platform}
              <span class="text-base text-base-400 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-1 group-hover:text-bloom" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Wrapper>
</section>
