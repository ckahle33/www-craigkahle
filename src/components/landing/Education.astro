---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
const data = [
  {
    period: "2009–2011",
    title: "Bachelor's in Broadcasting, Telecommunications and Mass Media",
    description: `Studied broadcasting, telecommunications and mass media with an emphasis on audio recording and engineering.`,
    location: "Temple University, Philadelphia, PA",
  },
  {
    period: "2007-2009",
    title: "Graphic Design",
    description: `Learned foundational design principles, including color theory, composition, and the basics of design.`,
    location: "Drexel University, Philadelphia, PA",
  },
];
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b py-8 border-base-200 dark:border-base-800"
    >
      <div class="lg:sticky lg:top-24 lg:z-40 self-start">
        <Text tag="h2" variant="textSM" class="text-base-900 dark:text-white">
          Education
        </Text>
      </div>
      <div class="flex flex-col gap-12 lg:col-span-2">
        {
          data.map((data, index) => (
            <article class="group relative grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-start ">
              <div class="lg:col-span-2">
                <Text
                  tag="h3"
                  variant="textSM"
                  class=" font-medium tracking-tight text-base-900 dark:text-white    "
                >
                  {data.title}
                </Text>
                <Text
                  tag="p"
                  variant="textXS"
                  class=" mt-1 text-base-400 dark:text-base-500      "
                >
                  {data.description}
                </Text>
                <Text
                  tag="span"
                  variant="textXS"
                  class="text-base-800 bold dark:text-base-500  lg:ml-auto"
                >
                  {data.location}
                </Text>
              </div>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-600 dark:text-base-400  lg:ml-auto"
              >
                <time datetime={data.period}> {data.period}</time>
              </Text>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
