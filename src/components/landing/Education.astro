---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
const data = [
  {
    period: "2009–2011",
    title: "Bachelor's in Broadcasting, Telecommunications and Mass Media",
    description: `Studied broadcasting, telecommunications and mass media with an emphasis on audio recording and engineering.`,
    location: "Temple University, Philadelphia, PA",
  },
  {
    period: "2007-2009",
    title: "Graphic Design",
    description: `Learned foundational design principles, including color theory, composition, and the basics of design.`,
    location: "Drexel University, Philadelphia, PA",
  },
];
---

<section>
  <Wrapper variant="standard">
    <div class="grid grid-cols-1 gap-6 border-b border-base-200 py-16 dark:border-base-800 md:grid-cols-[10rem_1fr]">
      <h2 class="self-start text-sm font-medium tracking-tight text-base-500 md:sticky md:top-8 md:pt-[2.15rem]">Education</h2>
      <ol class="flex flex-col">
        {data.map((item) => (
          <li class="grid gap-x-8 gap-y-1 border-t border-base-200 py-7 first:border-t-0 dark:border-base-800 sm:grid-cols-[1fr_auto]">
            <div>
              <h3 class="text-2xl font-medium tracking-tight text-base-950 dark:text-white sm:text-3xl">{item.location.split(",")[0]}</h3>
              <p class="mt-1 text-sm font-medium text-base-800 dark:text-base-200">{item.title}</p>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-base-600 dark:text-base-400">{item.description}</p>
            </div>
            <p class="text-sm tabular-nums text-base-500 sm:pt-2 sm:text-right">{item.period}</p>
          </li>
        ))}
      </ol>
    </div>
  </Wrapper>
</section>
